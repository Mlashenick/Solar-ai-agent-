# Copy to .env (local) or add these in Render → Environment.
# Any service left blank runs in DRY-RUN mode: messages are logged, not sent.

PORT=3000
DASHBOARD_PASSWORD=change-me
PUBLIC_URL=https://your-app.onrender.com
TIMEZONE=America/Los_Angeles
QUIET_START=9
QUIET_END=18

# Identity used in messages
COMPANY_NAME=Your Solar Co
REP_NAME=Marty

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Twilio SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SendGrid email
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# HubSpot private app token (crm.objects.contacts read/write)
HUBSPOT_TOKEN=
